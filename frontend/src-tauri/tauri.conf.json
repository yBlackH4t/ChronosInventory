{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "bin/estoque_backend"
    ],
    "resources": {
      "bin/estoque_backend_lib": "estoque_backend_lib"
    },
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": "v1Compatible"
  },
  "productName": "Chronos Inventory",
  "mainBinaryName": "Chronos Inventory",
  "version": "2.7.26",
  "identifier": "com.yblackh4t.chronosinventory",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzMTM5RjE3MUFCRTJENjEKUldSaExiNGFGNThUWTlMYXY1QVhLMnR3YW5ZMk1FOHpsNTBYUEZsUklkd05LOVdaeGVhYll6VzEK",
      "endpoints": [
        "https://github.com/yBlackH4t/ChronosInventory/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://127.0.0.1:* http://localhost:*",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*",
        "media-src": "'self' blob: data:",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Chronos Inventory",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "useHttpsScheme": true
      }
    ]
  }
}
