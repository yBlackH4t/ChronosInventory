{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "bin/estoque_backend"
    ],
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": "v1Compatible"
  },
  "productName": "Chronos Inventory",
  "mainBinaryName": "Chronos Inventory",
  "version": "2.1.3",
  "identifier": "com.yblackh4t.chronosinventory",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzMTM5RjE3MUFCRTJENjEKUldSaExiNGFGNThUWTlMYXY1QVhLMnR3YW5ZMk1FOHpsNTBYUEZsUklkd05LOVdaeGVhYll6VzEK",
      "endpoints": [
        "https://github.com/yBlackH4t/ChronosInventory/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Chronos Inventory",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "useHttpsScheme": true
      }
    ]
  }
}
