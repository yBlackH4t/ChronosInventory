{
  "name": "chronos_inventory_frontend",
  "private": true,
  "version": "2.7.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run changelog:sync && tsc -b && vite build",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ..\\\\build_backend.ps1",
    "verify:sidecar": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\verify_sidecar.ps1",
    "release:doctor": "python ..\\\\scripts\\\\release_doctor.py --frontend-dir frontend",
    "build:app": "npm run build:backend && npm run release:doctor && tauri build --bundles msi",
    "build:app:msi": "npm run build:backend && npm run release:doctor && tauri build --bundles msi",
    "build:all": "npm run build:app",
    "release:build": "npm run build:backend && npm run release:doctor && tauri build",
    "release:bump": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\bump_version.ps1",
    "release:check": "python ..\\\\scripts\\\\check_release_artifacts.py --frontend-dir frontend",
    "release:sign": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\release_sign.ps1",
    "release:publish": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\release_publish.ps1",
    "changelog:sync": "node ./scripts/sync_changelog.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/sora": "^5.3.0",
    "@mantine/carousel": "^9.6.3",
    "@mantine/core": "^9.6.3",
    "@mantine/dates": "^9.6.3",
    "@mantine/dropzone": "^9.6.3",
    "@mantine/form": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/modals": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@mantine/spotlight": "^9.6.3",
    "@number-flow/react": "^0.6.2",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/query-async-storage-persister": "^5.104.4",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-persist-client": "^5.104.4",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dayjs": "^1.11.23",
    "embla-carousel-react": "^8.6.0",
    "idb-keyval": "^6.3.0",
    "jsbarcode": "^3.12.3",
    "motion": "^12.43.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
